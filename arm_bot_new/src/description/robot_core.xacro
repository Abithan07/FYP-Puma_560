<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- ===================================================================
       3-DOF Modified PUMA 560 — Ideal Simulation Model
       DH Parameters (matching MATLAB Euler-Lagrange model exactly):
         alpha = [0, -pi/2, 0]
         a     = [0,  0,    0.4318]  m
         d     = [0,  0.2435, -0.0934]  m
       Gravity: 9.81 m/s² in -Z (set in world SDF)
       Damping = 0, Friction = 0  (ideal frictionless model)
       Self-collision disabled.
  =================================================================== -->

  <!-- World anchor (empty) -->
  <link name="world"/>

  <!-- Fixed base mounting -->
  <joint name="base_joint" type="fixed">
    <origin xyz="0.5 0.5 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child  link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="1 1 0.1"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="1 1 0.1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="12"/>
      <inertia ixx="2.26" ixy="0" ixz="0" iyy="6.26" iyz="0" izz="8.5"/>
    </inertial>
  </link>

  <!-- ── Link 1 (fixed vertical column) ─────────────────────────────── -->
  <xacro:property name="link_1_length" value="0.59817"/>
  <xacro:property name="link_1_radius" value="0.07493"/>

  <joint name="joint_1_shoulder" type="fixed">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="link_1"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
      <geometry>
        <mesh filename="package://arm_bot_new/meshes/puma_link1.stl"
              scale="0.0254 0.0254 0.0254"/>
      </geometry>
      <material name="purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
      <geometry>
        <mesh filename="package://arm_bot_new/meshes/puma_link1.stl"
              scale="0.0254 0.0254 0.0254"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.5" length="${link_1_length}" radius="${link_1_radius}">
      <origin xyz="0 0 ${link_1_length/2}" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ── Joint 1 (shoulder yaw) ─────────────────────────────────────── -->
  <!-- DH: alpha0=0, a0=0, d1=0  →  pure Z rotation at height 0.6718 m  -->
  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.6718" rpy="0 0 0"/>
    <parent link="link_1"/>
    <child  link="shoulder"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-8*pi/9}" upper="${8*pi/9}" velocity="2" effort="1000"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- MATLAB Link 1 — shoulder, m1=0.01 kg, CoG at [0,0,0] -->
  <xacro:property name="shoulder_length" value="${0.1686 + link_1_radius}"/>
  <xacro:property name="shoulder_radius" value="${link_1_radius}"/>

  <link name="shoulder">
    <visual>
      <origin xyz="0 -0.09677 0" rpy="${pi/2} 0 ${pi}"/>
      <geometry>
        <mesh filename="package://arm_bot_new/meshes/puma_link2.stl"
              scale="0.0254 0.0254 0.0254"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 -0.09677 0" rpy="${pi/2} 0 ${pi}"/>
      <geometry>
        <mesh filename="package://arm_bot_new/meshes/puma_link2.stl"
              scale="0.0254 0.0254 0.0254"/>
      </geometry>
    </collision>
    <xacro:inertial_link1>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_link1>
  </link>

  <!-- ── Joint 2 (shoulder pitch) ──────────────────────────────────── -->
  <!-- DH: alpha1=-pi/2, a1=0, d2=0.2435  →  rpy(-pi/2,0,0) + y-offset -->
  <joint name="joint_2" type="revolute">
    <origin xyz="0 0.2435 0" rpy="${-pi/2} 0 0"/>
    <parent link="shoulder"/>
    <child  link="link_2"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-5*pi/4}" upper="${pi/4}" velocity="2" effort="1000"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- MATLAB Link 2 — upper arm, m2=17.4 kg, CoG=[0.068, 0.006, -0.016] -->
  <xacro:property name="link_2_length" value="0.432"/>
  <xacro:property name="link_2_radius" value="0.065278"/>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_bot_new/meshes/puma_link3.stl"
              scale="0.0254 0.0254 0.0254"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_bot_new/meshes/puma_link3.stl"
              scale="0.0254 0.0254 0.0254"/>
      </geometry>
    </collision>
    <xacro:inertial_link2>
      <origin xyz="0.068 0.006 -0.016" rpy="0 0 0"/>
    </xacro:inertial_link2>
  </link>

  <!-- ── Joint 3 (elbow pitch) ─────────────────────────────────────── -->
  <!-- DH: alpha2=0, a2=0.4318, d3=-0.0934  →  straight offset         -->
  <!-- CRITICAL: d3=-0.0934 m (matches MATLAB exactly, not -0.094)      -->
  <joint name="joint_3" type="revolute">
    <origin xyz="0.4318 0 -0.0934" rpy="0 0 0"/>
    <parent link="link_2"/>
    <child  link="link_3"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi/4}" upper="${5*pi/4}" velocity="2" effort="1000"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <!-- MATLAB Link 3 — forearm, m3=4.8 kg, CoG=[0.000, -0.143, 0.014] -->
  <xacro:property name="link_3_length" value="0.233"/>
  <xacro:property name="link_3_radius" value="0.028702"/>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 ${0.0934/2}" rpy="0 0 ${-pi/2}"/>
      <geometry>
        <mesh filename="package://arm_bot_new/meshes/puma_link4.stl"
              scale="0.0254 0.0254 0.0254"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${0.0934/2}" rpy="0 0 ${-pi/2}"/>
      <geometry>
        <mesh filename="package://arm_bot_new/meshes/puma_link4.stl"
              scale="0.0254 0.0254 0.0254"/>
      </geometry>
    </collision>
    <xacro:inertial_link3>
      <origin xyz="0.0 -0.143 0.014" rpy="0 0 0"/>
    </xacro:inertial_link3>
  </link>

  <!-- ===================================================================
       Gazebo properties — ideal frictionless model, no self-collision
  =================================================================== -->
  <gazebo reference="base_link">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="link_1">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="shoulder">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="link_2">
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="link_3">
    <self_collide>false</self_collide>
  </gazebo>

</robot>
